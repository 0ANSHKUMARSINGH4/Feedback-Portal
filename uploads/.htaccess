# Security protections for uploads directory
# Disable PHP execution
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Deny execution of scripts
<FilesMatch "(?i)\.(php|php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|exe)$">
    Require all denied
</FilesMatch>

# Prevent directory indexing
Options -Indexes
